NODE_ENV=development
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173

# Database: prefer DATABASE_URL in hosted environments, split vars for local/dev if needed.
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=routing_dispatch
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DB_POOL_SIZE=5

# Auth
AUTH_PROVIDER=local
ALLOW_LOCAL_AUTH=true
AUTH_SESSION_ENFORCEMENT=true
JWT_SECRET=replace-with-a-strong-secret
API_KEY_HASH_SECRET=replace-with-a-different-strong-secret
JWT_EXPIRES_IN=7d
AUTH_ADMIN_EMAIL=admin@routing.local
AUTH_ADMIN_PASSWORD=ChangeMe123!
AUTH_ADMIN_USER_ID=admin-user
AUTH_ADMIN_ROLE=admin

# Queue / worker
QUEUE_REQUIRED=false
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_SCHEDULER=0

# Optimization / routing dependency mode
OPTIMIZATION_MODE=embedded
ROUTING_SERVICE_URL=
ROUTING_PROVIDER_URL=

# Storage / exports
STORAGE_MODE=local
STORAGE_PATH=
DISK_HEALTH_THRESHOLD_PERCENT=0.98

# Startup discipline
STRICT_ENV_VALIDATION=false

# Metrics / docs
# If set, /api/metrics requires Authorization: Bearer <METRICS_TOKEN> (or x-metrics-token).
# METRICS_TOKEN=replace-with-a-strong-secret
# Defaults to enabled outside production, disabled in production unless explicitly enabled.
SWAGGER_ENABLED=true

# Webhooks
# Limits how much of a webhook response body is captured/persisted for debugging.
# WEBHOOK_MAX_RESPONSE_BODY_BYTES=65536

# Public lead intake. Requests persist even when operator email is unavailable.
LEAD_INTAKE_EMAIL=sales@trytrovan.com
LEAD_INTAKE_FROM_EMAIL=notifications@trytrovan.com
# Comma-separated authenticated platform-operator accounts allowed to read global leads.
LEAD_INTAKE_OPERATOR_EMAILS=owner@trytrovan.com
LEAD_NOTIFICATION_MAX_ATTEMPTS=3
LEAD_NOTIFICATION_RETRY_BASE_SECONDS=60
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=notifications@trytrovan.com

# Assisted-pilot commercial mode. Public checkout and SMS are deliberately off.
LAUNCH_PROFILE=assisted-pilot
SELF_SERVE_BILLING_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=60
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_SCALE=

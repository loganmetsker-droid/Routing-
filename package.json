{
  "name": "routing-dispatch-saas",
  "version": "1.0.0",
  "description": "Routing & Dispatching SaaS Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "demo:preview": "node scripts/demo-preview-server.mjs",
    "build": "npm run build --workspaces",
    "verify:site-build": "node scripts/verify-public-seo-build.mjs",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "test:release-scripts": "node --test scripts/*.test.mjs",
    "capture:ui": "playwright test e2e/ui-audit.spec.ts --project=chromium",
    "audit:marketing": "node scripts/marketing-site-audit.mjs",
    "audit:product-ui": "node scripts/product-ui-audit.mjs",
    "capture:marketing-screenshots": "node --experimental-strip-types scripts/capture-marketing-screenshots.ts",
    "capture:launch-media": "node scripts/capture-launch-media.mjs",
    "verify:launch-media": "node scripts/verify-launch-media.mjs",
    "training:build:docket": "node scripts/run-launch-docket-build.mjs",
    "training:record:walkthroughs": "node scripts/capture-training-walkthroughs.mjs",
    "training:capture:guide": "node scripts/capture-training-guide-screenshots.mjs",
    "training:build:media": "node scripts/build-training-media.mjs && node scripts/normalize-training-media.mjs",
    "training:normalize:media": "node scripts/normalize-training-media.mjs",
    "training:verify:media": "node scripts/verify-training-media.mjs",
    "training:verify:narration": "node scripts/verify-training-narration.mjs",
    "training:remake:media": "npm run training:record:walkthroughs && npm run training:build:media && npm run training:verify:media && npm run training:verify:narration",
    "launch:audit": "playwright test e2e/launch-audit.spec.ts --project=chromium",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:optimizer": "node scripts/optimizer-smoke.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "launch:mvp-next": "node scripts/mvp-launch-next-step.mjs",
    "launch:env-status": "node scripts/launch-env-status.mjs",
    "release:check-scope": "node scripts/release-candidate-check.mjs",
    "release:snapshot": "node scripts/create-safety-snapshot.mjs",
    "release:build-candidate": "node scripts/build-release-candidate.mjs",
    "release:verify-identity": "node scripts/verify-release-identity.mjs",
    "release:verify-environment": "node scripts/validate-release-environment.mjs",
    "release:verify-launch-evidence": "node scripts/validate-launch-gate-evidence.mjs",
    "check:backend-deps": "npm ls --workspace=backend @nestjs/common @nestjs/core @nestjs/platform-express @nestjs/typeorm typeorm",
    "docker:dev": "docker-compose -f infrastructure/docker/docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f infrastructure/docker/docker-compose.yml up",
    "k8s:deploy": "kubectl apply -f infrastructure/k8s/"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^8.2.2",
    "sharp": "^0.35.3",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "browserslist": "4.28.8",
    "body-parser": "2.3.0",
    "brace-expansion@<2.0.0": "1.1.18",
    "brace-expansion@^2.0.2": "2.1.4",
    "brace-expansion@^5.0.5": "5.0.9",
    "fast-uri@>=3.0.0 <4": "3.1.7",
    "js-yaml": "5.3.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "postcss-selector-parser": "6.1.3",
    "qs": "6.16.0",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.0",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
